{
  "name": "erp-sih-saas",
  "private": true,
  "version": "0.0.0",
  "description": "Plateforme SaaS de Systeme d'Information Hospitalier (SIH) multi-etablissements",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @sih/api dev",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "arch:check": "pnpm --filter @sih/api arch:check"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}

// Schema Prisma — Module Identity + RBAC + UserTenantMembership (Phase 0, etape 2/13).
//
// Deux schemas PostgreSQL, conformement a ADR-0001 / 01-target-architecture.md §3.3 :
//   - "platform" : donnees de niveau plateforme, hors RLS tenant (UserAccount, Permission).
//   - "public"   : donnees tenant-scoped, RLS FORCE (UserTenantMembership, MembershipRole,
//                  HealthFacility), et le catalogue de roles (Role — voir commentaire sur ce
//                  modele : les lignes SYSTEM sont globales, les lignes TENANT sont
//                  RLS-isolees, une seule table porte les deux via `tenant_id NULL` pour les
//                  roles systeme).
//
// Les politiques RLS elles-memes (ALTER TABLE ... FORCE ROW LEVEL SECURITY, CREATE POLICY) ne
// sont pas exprimables en langage de schema Prisma : elles sont ajoutees a la main dans la
// migration SQL generee (prisma/migrations/<ts>_identity_rbac_init/migration.sql), avec un
// commentaire explicite les reperant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "public"]
}

enum PlatformRole {
  SUPER_ADMIN
  NONE

  @@schema("platform")
}

enum RoleScope {
  SYSTEM
  TENANT

  @@schema("public")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("public")
}

/// Identite globale d'une personne (voir domain/UserAccount.ts). Aucun tenant_id : c'est ce
/// qui permet de retrouver un compte par email au login, avant qu'un contexte tenant existe.
model UserAccount {
  id           String       @id @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  platformRole PlatformRole @map("platform_role")
  createdAt    DateTime     @map("created_at")

  mfaEnrollment MfaEnrollment?
  refreshTokens RefreshToken[]

  @@map("UserAccount")
  @@schema("platform")
}

/// Catalogue de permissions — niveau plateforme, source de verite unique (01-target-architecture.md §7.2).
model Permission {
  code        String   @id
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@schema("platform")
}

/// Role systeme (scope SYSTEM, tenant_id NULL, catalogue global immuable des 18 roles) OU role
/// personnalise d'etablissement (scope TENANT, tenant_id obligatoire). Une seule table pour les
/// deux : la politique RLS `tenant_isolation` couvre les lignes TENANT, une politique
/// additionnelle `system_role_catalog_read` (voir migration) autorise la lecture des lignes
/// SYSTEM (tenant_id NULL) quel que soit le contexte de session.
model Role {
  id              String    @id @db.Uuid
  code            String
  name            String
  scope           RoleScope
  tenantId        String?   @map("tenant_id") @db.Uuid
  permissionCodes String[]  @map("permission_codes")
  createdAt       DateTime  @default(now()) @map("created_at")

  membershipRoles MembershipRole[]

  // Unicite des roles TENANT par (tenant_id, code) ; l'unicite globale des codes SYSTEM
  // (tenant_id NULL) est imposee par un index partiel ajoute a la main en migration, car
  // Postgres ne traite pas NULL comme une valeur egale a elle-meme dans une contrainte UNIQUE
  // standard.
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("Role")
  @@schema("public")
}

/// Appartenance d'un UserAccount a UN etablissement (voir domain/UserTenantMembership.ts).
/// Table tenant-scoped, RLS FORCE.
model UserTenantMembership {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  status    MembershipStatus
  joinedAt  DateTime         @map("joined_at")
  leftAt    DateTime?        @map("left_at")
  createdAt DateTime         @map("created_at")
  createdBy String           @map("created_by") @db.Uuid

  roles MembershipRole[]

  // Pas de contrainte UNIQUE(user_id, tenant_id) globale : un membership REVOKED n'empeche pas
  // un octroi ulterieur (nouvelle ligne). L'unicite porte uniquement sur les memberships ACTIFS
  // — imposee par un index unique partiel ajoute a la main en migration (defense en profondeur
  // en plus du controle applicatif de GrantMembershipHandler).
  @@index([tenantId, status])
  @@index([userId, tenantId])
  @@map("UserTenantMembership")
  @@schema("public")
}

/// Table de jonction membership <-> role (un membership peut porter plusieurs roles
/// simultanes — decision non negociable de cette etape). `tenant_id` est denormalise depuis le
/// membership pour que la politique RLS s'applique directement sur cette table sans jointure.
model MembershipRole {
  id           String   @id @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assignedAt   DateTime @map("assigned_at")

  membership UserTenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([tenantId])
  @@map("MembershipRole")
  @@schema("public")
}

enum FacilityStatus {
  ACTIVE
  SUSPENDED

  @@schema("public")
}

// =================================================================================================
// Module Subscription (Phase 0, etape 4/13) — Plan / PlanPrice / Subscription / SubscriptionPlanChange.
//
// Toutes ces tables vivent dans le schema "platform", EXPLICITEMENT SANS RLS (ADR-0001 §3.3 :
// "Les donnees de niveau plateforme vivent dans un schema platform distinct, hors RLS tenant" —
// abonnements et forfaits sont cites nommement dans cette decision). Ne JAMAIS ajouter de
// politique RLS ni de FORCE ROW LEVEL SECURITY sur ces tables : ce serait contraire a la
// conception actee, et romprait la coherence documentee ici. `Subscription` et
// `SubscriptionPlanChange` portent tout de meme `tenant_id` (colonne simple, sans politique) : ce
// n'est PAS un oubli d'y ajouter du RLS, c'est un choix — le filtrage tenant sur ces deux tables
// est PUREMENT APPLICATIF (voir PrismaSubscriptionRepository.ts / PrismaPlanChangeRepository.ts,
// qui filtrent explicitement par tenant_id sur CHAQUE methode ; couvert par
// test/subscription/integration/subscriptionRepositoryTenantIsolation.test.ts, qui joue le meme
// role que rls.test.ts pour les tables du schema public).
//
// `Plan` et `PlanPrice` n'ont, eux, aucune notion de tenant : catalogue global visible de tous.
//
// Aucune contrainte FOREIGN KEY declaree via `@relation` Prisma sur les colonnes planId /
// planPriceId / fromPlanId / toPlanId / fromPlanPriceId / toPlanPriceId : choix deliberement
// minimal pour eviter la prolifération de relations nommees (plusieurs FK vers le meme modele
// sur SubscriptionPlanChange). L'integrite referentielle est appliquee a la main en migration
// SQL (ALTER TABLE ... ADD CONSTRAINT ... FOREIGN KEY), meme pattern que les ajouts manuels deja
// presents dans ce schema (politiques RLS, index partiels) — voir le commentaire en tete de la
// migration correspondante.
// =================================================================================================

enum PlanCode {
  STANDARD
  PROFESSIONNEL
  COMPLET

  @@schema("platform")
}

enum BillingPeriod {
  MENSUEL
  ANNUEL

  @@schema("platform")
}

/// GRACE_PERIOD/DEGRADED ajoutes a l'etape 5 (integration O-25/O-03) — extension explicitement
/// autorisee du perimetre de l'etape 4 (voir domain/Subscription.ts pour les transitions), PAS
/// une nouvelle machine a etats au sens d'O-25.5 (celle-ci concerne exclusivement PaymentStatus) :
/// ce sont les etats de cycle de vie de l'ABONNEMENT decrits en prose par O-03/§6.3
/// ("periode de grace de 7 jours" / "mode degrade pendant 30 jours"), qui n'avaient simplement
/// jamais ete formalises en enum avant cette etape.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  DEGRADED

  @@schema("platform")
}

/// Une seule valeur en V1 : le downgrade reste differe a la fin de periode et n'est pas
/// implemente par cette etape (O-02.6) — voir domain/value-objects/PlanChangeType.ts.
enum SubscriptionPlanChangeType {
  UPGRADE

  @@schema("platform")
}

/// Catalogue global de forfaits (voir domain/Plan.ts). Aucun tenant_id : visible de tous.
model Plan {
  id        String   @id @db.Uuid
  code      PlanCode @unique
  name      String
  maxUsers  Int      @map("max_users")
  maxBeds   Int      @map("max_beds")
  createdAt DateTime @map("created_at")

  @@map("Plan")
  @@schema("platform")
}

/// Tarif historise d'un Plan, DISTINCT du Plan lui-meme (voir domain/PlanPrice.ts). Append-only :
/// aucune ligne existante n'est jamais mise a jour, un nouveau tarif = une nouvelle ligne.
model PlanPrice {
  id            String        @id @db.Uuid
  planId        String        @map("plan_id") @db.Uuid
  amount        Int
  period        BillingPeriod
  effectiveFrom DateTime      @map("effective_from")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([planId, period, effectiveFrom])
  @@map("PlanPrice")
  @@schema("platform")
}

/// Agregat racine liant un tenant a un forfait via le PlanPrice reellement applique (voir
/// domain/Subscription.ts). `tenant_id` colonne simple, SANS RLS (voir commentaire de tete de
/// section) — filtrage explicite obligatoire dans chaque methode du repository.
/// `@@unique([tenantId])` impose l'invariant "un Tenant a exactement un Subscription" au niveau
/// base, en plus de la verification applicative.
model Subscription {
  id                 String             @id @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  currentPlanPriceId String             @map("current_plan_price_id") @db.Uuid
  period             BillingPeriod
  status             SubscriptionStatus
  trialEndsAt        DateTime?          @map("trial_ends_at")
  periodStartsAt     DateTime           @map("period_starts_at")
  periodEndsAt       DateTime           @map("period_ends_at")
  createdAt          DateTime           @map("created_at")
  // Ajoutes a l'etape 5 (O-03/O-25) — horodatages du cycle grace/degrade, tous NULL tant que le
  // statut n'a jamais quitte TRIALING/ACTIVE. Voir domain/Subscription.ts.
  gracePeriodStartedAt           DateTime? @map("grace_period_started_at")
  degradedModeEnteredAt          DateTime? @map("degraded_mode_entered_at")
  degradedModeSustainedNotifiedAt DateTime? @map("degraded_mode_sustained_notified_at")
  /// Verrouillage optimiste PUREMENT technique (voir PrismaSubscriptionRepository.ts), replique du
  /// meme mecanisme sur Payment : trois writers peuvent desormais ecrire ce MEME abonnement
  /// concurremment (application d'un upgrade paye, reactivation sur paiement, scheduler de
  /// renouvellement). N'est PAS un concept de domaine : absent de Subscription/SubscriptionProps.
  version                        Int       @default(0)

  @@unique([tenantId])
  @@map("Subscription")
  @@schema("platform")
}

/// Historique APPEND-ONLY des changements de forfait (voir domain/PlanChange.ts). `tenant_id`
/// colonne simple, SANS RLS, meme regime que Subscription ci-dessus.
model SubscriptionPlanChange {
  id              String                     @id @db.Uuid
  subscriptionId  String                     @map("subscription_id") @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  changeType      SubscriptionPlanChangeType @map("change_type")
  fromPlanId      String                     @map("from_plan_id") @db.Uuid
  fromPlanPriceId String                     @map("from_plan_price_id") @db.Uuid
  toPlanId        String                     @map("to_plan_id") @db.Uuid
  toPlanPriceId   String                     @map("to_plan_price_id") @db.Uuid
  proratedAmount  Int                        @map("prorated_amount")
  /// Date de la DEMANDE d'upgrade, desormais distincte de `occurred_at` (date d'APPLICATION
  /// effective, apres confirmation du paiement). NULLABLE pour les lignes anterieures a la passe 2,
  /// ou les deux instants coincidaient — backfillees a `occurred_at` (voir migration
  /// 20260825090000).
  requestedAt     DateTime?                  @map("requested_at")
  /// Facture plateforme ayant paye cet upgrade. SANS FOREIGN KEY : `PlatformInvoice` appartient au
  /// module `payment`, aucune contrainte cross-module en base (voir migration 20260825090000).
  platformInvoiceId String?                  @map("platform_invoice_id") @db.Uuid
  occurredAt      DateTime                   @map("occurred_at")

  @@index([subscriptionId])
  @@index([tenantId])
  @@map("SubscriptionPlanChange")
  @@schema("platform")
}

/// Demande d'upgrade EN ATTENTE DE PAIEMENT (voir domain/PlanUpgradeRequest.ts). `id` = le
/// PlanChangeId PRE-ATTRIBUE a la demande, qui voyage comme `source_reference` jusqu'a la facture
/// plateforme puis revient dans `SaaSPaymentSucceeded`. `@@unique([subscriptionId])` : LA barriere
/// anti-double-soumission (une seule demande en attente par abonnement, imposee en base). Aucune
/// colonne `status` : la PRESENCE de la ligne est le fait "upgrade en attente" ; elle est supprimee
/// a l'application, l'historique definitif etant `SubscriptionPlanChange`.
model SubscriptionPlanUpgradeRequest {
  id                    String   @id @db.Uuid
  subscriptionId        String   @map("subscription_id") @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  fromPlanId            String   @map("from_plan_id") @db.Uuid
  fromPlanPriceId       String   @map("from_plan_price_id") @db.Uuid
  toPlanId              String   @map("to_plan_id") @db.Uuid
  toPlanPriceId         String   @map("to_plan_price_id") @db.Uuid
  proratedAmount        Int      @map("prorated_amount")
  coveredPeriodStartsAt DateTime @map("covered_period_starts_at")
  coveredPeriodEndsAt   DateTime @map("covered_period_ends_at")
  requestedAt           DateTime @map("requested_at")
  expiresAt             DateTime @map("expires_at")

  @@unique([subscriptionId])
  @@index([tenantId])
  @@map("SubscriptionPlanUpgradeRequest")
  @@schema("platform")
}

// =================================================================================================
// Outbox (Phase 0, etape 5/13, relais migre vers BullMQ a l'etape 6/13) — D9
// (01-target-architecture.md §9.3, ADR-0004).
//
// Table `platform.OutboxMessage`, HORS RLS (ADR-0001 §3.3), comme Subscription/PlanPrice/Plan
// ci-dessus : le relais (shared-kernel/infrastructure/persistence/OutboxRelay.ts +
// shared-kernel/infrastructure/queue/OutboxWorker.ts, ADR-0004) est un PROCESSUS DE NIVEAU
// PLATEFORME qui doit lire les messages de TOUS les tenants pour les distribuer ; une RLS par
// tenant sur cette table serait directement incompatible avec ce role. Ecrite par
// `shared-kernel/infrastructure/persistence/OutboxWriter.ts`, dans la MEME transaction que
// l'agregat qui emet l'evenement (D9) — jamais par un module applicatif directement.
//
// Reste la source de verite TRANSACTIONNELLE et le mecanisme de reprise apres crash /
// dead-letter (`status`, `attempts`, `locked_at`/`locked_by`) : BullMQ (Redis) ne fait QUE
// distribuer la CHARGE de traitement a un ou plusieurs workers concurrents une fois qu'une ligne
// a ete reclamee ici — voir le commentaire de tete de OutboxRelay.ts/OutboxWorker.ts pour le
// detail de cette repartition des responsabilites.
// =================================================================================================

enum OutboxMessageStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@schema("platform")
}

/// File d'attente Outbox generique, partagee par tous les modules (voir OutboxWriter.ts /
/// OutboxRelay.ts). `tenant_id` NULLABLE : certains evenements de plateforme n'ont pas de portee
/// tenant (voir `DomainEvent.tenantId: string | null`).
model OutboxMessage {
  id           String              @id @db.Uuid
  eventType    String              @map("event_type")
  eventVersion Int                 @map("event_version")
  aggregateId  String              @map("aggregate_id")
  tenantId     String?             @map("tenant_id") @db.Uuid
  payload      Json
  status       OutboxMessageStatus @default(PENDING)
  occurredAt   DateTime            @map("occurred_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  attempts     Int                 @default(0)
  lockedAt     DateTime?           @map("locked_at")
  lockedBy     String?             @map("locked_by")
  processedAt  DateTime?           @map("processed_at")
  lastError    String?             @map("last_error")

  consumedBy OutboxConsumedEvent[]

  // Index compose sur le couple filtre par le relais (`WHERE status = ...`, `ORDER BY
  // occurred_at`) — evite un balayage complet de la table a chaque cycle de polling.
  @@index([status, occurredAt])
  @@map("OutboxMessage")
  @@schema("platform")
}

/// Registre GENERIQUE d'idempotence consommateur (etape 6/13, D9 : "tout consommateur est
/// idempotent -> cle d'idempotence + registre des evenements traites"). Une ligne = "CE handler a
/// deja applique les effets de CE message Outbox" — cle primaire composite
/// `(outbox_message_id, handler_name)` : le MEME message peut etre traite par PLUSIEURS handlers
/// distincts (voir composition-root.ts, `payment.payment.saas-payment-succeeded` a trois
/// consommateurs), chacun devant etre dedupliqué INDEPENDAMMENT des autres.
///
/// Ecrite par le wrapper generique `shared-kernel/infrastructure/persistence/
/// OutboxIdempotencyGuard.ts`, seul point d'ecriture — jamais par un module applicatif
/// directement (meme discipline que OutboxMessage/OutboxWriter.ts ci-dessus). Vecue comme un
/// registre PUREMENT TECHNIQUE de premiere ligne de defense : les contraintes UNIQUE metier
/// existantes (`PlatformInvoice_subscription_id_purpose_period_starts_at_key`,
/// `Payment_provider_transaction_id_key`, `version` optimiste...) restent en place en defense
/// supplementaire, mais ne sont plus la SEULE garantie d'idempotence, desormais uniforme sur tous
/// les handlers sans exception.
///
/// `handler_name` est une chaine STABLE choisie au cablage (composition-root.ts) — PAS le nom de
/// la fonction JS (mangled/anonyme pour les handlers produits par une factory `createXxx...`) :
/// voir le commentaire de tete de OutboxIdempotencyGuard.ts pour la convention de nommage.
model OutboxConsumedEvent {
  outboxMessageId String   @map("outbox_message_id") @db.Uuid
  handlerName     String   @map("handler_name")
  processedAt     DateTime @map("processed_at")

  outboxMessage OutboxMessage @relation(fields: [outboxMessageId], references: [id], onDelete: Cascade)

  @@id([outboxMessageId, handlerName])
  @@map("OutboxConsumedEvent")
  @@schema("platform")
}

// =================================================================================================
// Module Payment (Phase 0, etape 5/13) — Payment / PlatformInvoice, integration O-25.
//
// Memes principes que le module Subscription (schema "platform", HORS RLS, ADR-0001 §3.3) :
// `Payment` et `PlatformInvoice` sont des donnees de niveau plateforme (encaissement de
// l'abonnement de l'ETABLISSEMENT a la PLATEFORME, distinct d'O-18/paiement patient). Filtrage
// tenant PUREMENT APPLICATIF dans chaque repository (voir infrastructure/persistence/), couvert
// par un test d'isolation dedie (meme pattern que subscriptionRepositoryTenantIsolation.test.ts).
//
// Aucune contrainte FOREIGN KEY declaree vers `platform.Subscription` : choix deliberement
// coherent avec la regle "un module possede ses propres collections, aucune requete/contrainte
// cross-module en base" (Payment ne DOIT PAS dependre au niveau schema d'une table appartenant au
// module Subscription) — seule une FK INTRA-module (`Payment.platformInvoiceId` ->
// `PlatformInvoice.id`) est declaree, meme raisonnement que
// `SubscriptionPlanChange -> Subscription` a l'etape 4.
// =================================================================================================

enum PaymentMethod {
  MOBILE_MONEY
  CARD

  @@schema("platform")
}

/// Six valeurs EXACTES imposees par O-25.5 ("Etats reutilises tels quels de la Saga (§5/§6.3),
/// aucune nouvelle machine a etats : PENDING/SUCCEEDED/FAILED/EXPIRED/ANNULE/RENOUVELE") —
/// identifiants traduits en anglais (convention du depot), aucune valeur ajoutee ni retranchee.
/// Voir domain/value-objects/PaymentStatus.ts pour la table de transitions autorisees et le
/// commentaire sur l'usage de RENEWED (point signale a l'architecte, non totalement contraint par
/// l'ADR).
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  RENEWED

  @@schema("platform")
}

/// A quoi correspond ce paiement (O-25.1 : "abonnement initial + renouvellements"). `UPGRADE`
/// reserve pour un branchement futur (voir domain/Payment.ts) — non emis par cette etape.
enum PaymentPurpose {
  INITIAL
  RENEWAL
  UPGRADE

  @@schema("platform")
}

/// A quoi correspond une facture PLATEFORME. Deux chemins d'emission, et deux seulement :
/// l'echeance de renouvellement (IssuePlatformInvoiceOnRenewalDue.ts) et l'upgrade proratise
/// (IssuePlatformInvoiceOnUpgradeRequested.ts). Volontairement SANS valeur 'INITIAL' : aucune
/// valeur non emise n'est declaree ici (voir domain/value-objects/PlatformInvoicePurpose.ts).
enum PlatformInvoicePurpose {
  RENEWAL
  UPGRADE

  @@schema("platform")
}

/// Minimal V1 : une facture plateforme est emise puis payee. Pas d'annulation/avoir — hors
/// perimetre V1 (O-25.1 : remboursement d'abonnement SaaS explicitement hors V1).
enum PlatformInvoiceStatus {
  ISSUED
  PAID

  @@schema("platform")
}

/// Registre de ce qui est du a la plateforme pour UNE periode de facturation d'UN abonnement
/// (voir domain/PlatformInvoice.ts). `planPriceId` : reference au `PlanPrice` REELLEMENT resolu
/// au moment de l'emission (jamais recalcule depuis `Plan`, meme discipline que
/// `SubscriptionPlanChange`, O-02.6). `@@unique([subscriptionId, purpose, periodStartsAt])` :
/// empeche deux factures de MEME NATURE pour la MEME periode d'un MEME abonnement — c'est la
/// barriere qui rend l'emission concurrente idempotente (voir
/// application/services/IssuePlatformInvoiceOnRenewalDue.ts et le test adversarial "deux
/// renouvellements concurrents"). `purpose` y a ete ajoute a la passe 2 pour qu'une facture
/// d'UPGRADE puisse coexister avec la facture de RENOUVELLEMENT de la meme periode ;
/// generalisation stricte pour le chemin de renouvellement, ou `purpose` est constant.
model PlatformInvoice {
  id             String                 @id @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  subscriptionId String                 @map("subscription_id") @db.Uuid
  planPriceId    String                 @map("plan_price_id") @db.Uuid
  purpose        PlatformInvoicePurpose
  /// Reference OPAQUE du fait metier a l'origine de cette facture (a la passe 2 : le PlanChangeId
  /// d'une demande d'upgrade). NULL pour les factures de renouvellement — en PostgreSQL, les NULL
  /// ne collisionnent jamais entre eux dans un index UNIQUE. Le module `payment` ne sait rien de
  /// ce que cette chaine designe : c'est precisement ce qui evite tout couplage a `subscription`.
  sourceReference String?               @unique @map("source_reference")
  amount         Int
  periodStartsAt DateTime               @map("period_starts_at")
  periodEndsAt   DateTime               @map("period_ends_at")
  status         PlatformInvoiceStatus
  issuedAt       DateTime               @map("issued_at")
  paidAt         DateTime?              @map("paid_at")

  payments Payment[]

  @@unique([subscriptionId, purpose, periodStartsAt])
  @@index([tenantId])
  @@map("PlatformInvoice")
  @@schema("platform")
}

/// Une TENTATIVE de paiement pour une `PlatformInvoice` (voir domain/Payment.ts). Plusieurs
/// `Payment` peuvent viser la meme facture (ex. un premier essai FAILED, un second SUCCEEDED) —
/// c'est la facture, pas la tentative, qui porte la verite "est-ce paye" (`PlatformInvoice.status`).
/// `providerTransactionId` UNIQUE NOT NULL : cle d'idempotence webhook imposee par O-25.5 ("
/// Idempotence par identifiant de transaction fournisseur").
model Payment {
  id                    String         @id @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  platformInvoiceId     String         @map("platform_invoice_id") @db.Uuid
  subscriptionId        String         @map("subscription_id") @db.Uuid
  purpose               PaymentPurpose
  method                PaymentMethod
  amount                Int
  status                PaymentStatus
  providerTransactionId String         @unique @map("provider_transaction_id")
  initiatedAt           DateTime       @map("initiated_at")
  confirmedAt           DateTime?      @map("confirmed_at")
  /// Verrouillage optimiste PUREMENT technique (voir PrismaPaymentRepository.ts) : empeche un
  /// lost-update entre le webhook de confirmation et le rapprochement periodique, qui peuvent
  /// tous deux ecrire ce MEME Payment concurremment (ex. SUCCEEDED via webhook puis EXPIRED via
  /// rapprochement ecrasant silencieusement le succes deja commite). N'est PAS un concept de
  /// domaine : absent de Payment/PaymentProps, connu uniquement de l'infrastructure.
  version               Int            @default(0)

  platformInvoice PlatformInvoice @relation(fields: [platformInvoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([platformInvoiceId])
  @@map("Payment")
  @@schema("platform")
}

/// Agregat racine du tenant (voir domain/HealthFacility.ts, 01-target-architecture.md §6.4).
/// Module Tenant (Phase 0, etape 3/13) — perimetre volontairement minimal : isolation RLS,
/// pas le modele metier complet de l'etablissement (FacilityType, Service, Building, Room, Bed
/// restent hors perimetre).
///
/// `tenant_id` DUPLIQUE INTENTIONNELLEMENT `id` — ce n'est pas une redondance accidentelle.
/// Cette table EST le tenant lui-meme (contrairement a toutes les autres tables tenant-scoped
/// de ce schema, ou `tenant_id` reference un tenant distinct de la ligne). Le garde-fou
/// generique de non-fuite RLS impose par ADR-0001 (section "Consequences") enumere TOUTES les
/// tables du schema "public" et echoue si l'une d'elles n'a pas `tenant_id NOT NULL` **et** une
/// politique RLS active, SANS exception pour l'agregat racine — voir
/// test/tenant/integration/rlsGuard.test.ts. Omettre `tenant_id` sur cette table pour la seule
/// raison qu'elle "est" le tenant serait exactement le genre d'exception ad hoc que ce
/// garde-fou generique est cense rendre impossible d'oublier.
model HealthFacility {
  id        String         @id @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  name      String
  status    FacilityStatus
  createdAt DateTime       @map("created_at")

  @@map("HealthFacility")
  @@schema("public")
}

/// Configuration technique minimale d'un tenant, semee en fin de Saga de provisioning (ADR-0008
/// §10/§11, amendement 1, Phase 0 etape 10/13) — voir modules/tenant/domain/FacilitySettings.ts.
/// AUCUN CONTENU METIER HOSPITALIER (services, batiments, catalogue d'actes restent Phase 1).
/// `id` est ICI DISTINCT de `tenant_id` (contrairement a `HealthFacility` ci-dessus) : UNE ligne
/// au plus par tenant, imposee par la contrainte UNIQUE ci-dessous, en plus du controle
/// applicatif (`SeedFacilityConfigurationHandler`).
model FacilitySettings {
  id                      String    @id @db.Uuid
  tenantId                String    @unique @map("tenant_id") @db.Uuid
  locale                  String
  timezone                String
  currency                String
  phoneCountryCode        String    @map("phone_country_code")
  createdAt               DateTime  @map("created_at")
  /// Marqueur d'idempotence de la derniere etape de la Saga (ADR-0008 §11) — JAMAIS consulte par
  /// `TenantModuleBackedAccessChecker` (composition-root.ts, ADR-0008 §3/§11).
  provisioningCompletedAt DateTime? @map("provisioning_completed_at")

  @@map("FacilitySettings")
  @@schema("public")
}

// =================================================================================================
// Module Identity — MFA TOTP (Phase 0, etape 7/13, ADR-0005).
//
// `MfaEnrollment`/`MfaRecoveryCode` vivent dans le schema "platform", HORS RLS — meme regime que
// `UserAccount` (ADR-0005 §1) : le MFA est un concept d'IDENTITE GLOBALE (lie a `UserAccount` par
// `user_id` uniquement), jamais tenant-scoped. Aucune colonne `tenant_id` sur ces deux tables :
// ce n'est pas un oubli, c'est la decision actee par l'ADR — un `SUPER_ADMIN` (contexte PLATFORM,
// sans tenant) est structurellement soumis au MFA au meme titre qu'un utilisateur d'etablissement.
//
// `@@unique([userId])` sur MfaEnrollment : au plus UNE ligne par utilisateur (ADR-0005 §1) —
// "facteur courant + facteur en attente" DANS LE MEME agregat, jamais un agregat par facteur.
// `version` : verrouillage optimiste PUREMENT technique (voir PrismaMfaEnrollmentRepository.ts),
// meme pattern que `Subscription`/`Payment` — absent de MfaEnrollmentProps (domaine).
// =================================================================================================

enum MfaEnrollmentStatus {
  PENDING_ACTIVATION
  ACTIVE
  RESET_REQUIRED

  @@schema("platform")
}

enum MfaFactorType {
  TOTP

  @@schema("platform")
}

/// Agregat racine du second facteur (voir domain/MfaEnrollment.ts). `activeSecret`/`pendingSecret`
/// sont des enveloppes AES-256-GCM OPAQUES (`v1.<keyId>.<iv>.<tag>.<ciphertext>`, ADR-0005 §2) —
/// jamais un secret en clair. Aucune methode de desactivation n'existe cote domaine (O-04.5) :
/// le seul chemin de sortie d'un facteur ACTIVE est `forceReEnrollment` (-> RESET_REQUIRED).
model MfaEnrollment {
  id                        String              @id @db.Uuid
  userId                    String              @unique @map("user_id") @db.Uuid
  status                    MfaEnrollmentStatus
  factorType                MfaFactorType       @map("factor_type")
  activeSecret              String?             @map("active_secret")
  pendingSecret             String?             @map("pending_secret")
  lastAcceptedTimeStep      Int?                @map("last_accepted_time_step")
  /// Distinct de `lastAcceptedTimeStep` (pose UNIQUEMENT par `confirmEnrollment`, jamais lu par
  /// `registerSuccessfulChallenge`) — decouple l'anti-rejeu du CHALLENGE de connexion de celui de
  /// la CONFIRMATION d'enrolement (revue de securite independante de l'etape 12/13, AC-1 : sans
  /// ce champ, confirmer l'enrolement puis se connecter dans la MEME fenetre TOTP de 30s rejetait
  /// a tort le premier challenge comme "code deja utilise").
  lastAcceptedChallengeTimeStep Int?             @map("last_accepted_challenge_time_step")
  consecutiveFailedAttempts Int                 @default(0) @map("consecutive_failed_attempts")
  lockedUntil               DateTime?           @map("locked_until")
  activatedAt               DateTime?           @map("activated_at")
  createdAt                 DateTime            @map("created_at")
  updatedAt                 DateTime            @map("updated_at")
  /// Verrouillage optimiste PUREMENT technique — voir commentaire de tete de section.
  version                   Int                 @default(0)

  account       UserAccount       @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@map("MfaEnrollment")
  @@schema("platform")
}

/// Entite INTERNE de `MfaEnrollment` (voir domain/MfaRecoveryCode.ts) — jamais chargee ni
/// sauvegardee independamment de sa racine. `codeHash` : enveloppe HMAC-SHA-256 OPAQUE
/// (`v1.<pepperId>.<hmac>`, ADR-0005 §3), jamais le code en clair. Consommation a usage unique :
/// `UPDATE ... WHERE id = ? AND consumed_at IS NULL` (voir PrismaMfaEnrollmentRepository.ts),
/// atomique par construction.
model MfaRecoveryCode {
  id           String    @id @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  codeHash     String    @map("code_hash")
  createdAt    DateTime  @map("created_at")
  consumedAt   DateTime? @map("consumed_at")

  enrollment MfaEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("MfaRecoveryCode")
  @@schema("platform")
}

// =================================================================================================
// Sessions avancees — refresh token a rotation (Phase 0, etape 8/13, ADR-0006).
//
// `platform.RefreshToken`, HORS RLS : meme regime que `MfaEnrollment`/`AuditEntry` (concept
// d'identite/session globale, pas de donnee clinique tenant-scopee ; `tenantId` NULLABLE car une
// chaine issue d'un contexte PLATFORM n'a structurellement pas de tenant).
//
// Une ligne par GENERATION de la chaine (`chainId` partage, `previousTokenId` chaine) — jamais de
// mutation en place de la ligne active. Rotation atomique :
// `UPDATE ... WHERE token_hash = ? AND status = 'ACTIVE'` (voir PrismaRefreshTokenRepository.ts),
// EXACTEMENT le pattern deja en production pour `MfaRecoveryCode.consumedAt` (ADR-0005 §3).
//
// `tokenHash` UNIQUE : enveloppe HMAC-SHA-256 OPAQUE (`v1.<pepperId>.<hmac>`, ADR-0006 §4),
// jamais le secret en clair. `absoluteExpiresAt` est fixe a la creation de la chaine et copie tel
// quel a chaque rotation (jamais recalcule) — voir domain/RefreshToken.ts pour l'invariant complet.
// =================================================================================================

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED

  @@schema("platform")
}

/// Miroir de `domain/value-objects/SessionSensitivityCategory.ts` (ADR-0006 §1) — jamais une
/// taxonomie plus fine que ce qu'O-04.1/`MfaPolicy.ts` materialisent deja.
enum RefreshTokenSensitivityCategory {
  PLATFORM_SUPER_ADMIN
  TENANT_MFA_REQUIRED
  TENANT_STANDARD

  @@schema("platform")
}

/// Une generation de refresh token au sein d'une chaine de rotation (voir domain/RefreshToken.ts,
/// ADR-0006 §5). `sessionId` : identifiant Redis de la session COMPLETE actuellement associee a
/// cette generation — permet de retrouver/revoquer la chaine depuis une fermeture de session
/// (`revokeChainBySessionId`, deconnexion/revocation).
model RefreshToken {
  id                  String                           @id @db.Uuid
  chainId             String                           @map("chain_id") @db.Uuid
  userId              String                           @map("user_id") @db.Uuid
  tenantId            String?                          @map("tenant_id") @db.Uuid
  membershipId        String?                          @map("membership_id") @db.Uuid
  sensitivityCategory RefreshTokenSensitivityCategory   @map("sensitivity_category")
  tokenHash           String                           @unique @map("token_hash")
  status              RefreshTokenStatus               @default(ACTIVE)
  sessionId           String                           @map("session_id")
  previousTokenId     String?                          @map("previous_token_id") @db.Uuid
  chainStartedAt      DateTime                         @map("chain_started_at")
  absoluteExpiresAt   DateTime                         @map("absolute_expires_at")
  inactivityExpiresAt DateTime                         @map("inactivity_expires_at")
  issuedAt            DateTime                         @map("issued_at")
  revokedAt           DateTime?                        @map("revoked_at")
  revokedReason       String?                          @map("revoked_reason")

  account UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chainId])
  @@index([userId])
  @@index([membershipId])
  @@index([sessionId])
  @@map("RefreshToken")
  @@schema("platform")
}

enum SuperAdminBreakGlassRequestStatus {
  PENDING
  APPROVED

  @@schema("platform")
}

/// Recuperation break-glass d'un SUPER_ADMIN (ADR-0005 Amendement 1, O-04 residu 4). Aucune
/// relation Prisma vers UserAccount (memes raisons qu'AuditEntry : trois references distinctes a
/// la meme table nommeraient trois relations, et cette table ne doit jamais cascade-supprimer avec
/// un compte). Hors RLS : concept d'administration plateforme, jamais tenant-scope.
model SuperAdminBreakGlassRequest {
  id                    String                             @id @db.Uuid
  requestedByUserId     String                             @map("requested_by_user_id") @db.Uuid
  subjectUserAccountId  String                             @map("subject_user_account_id") @db.Uuid
  reason                String
  status                SuperAdminBreakGlassRequestStatus  @default(PENDING)
  approvedByUserId      String?                            @map("approved_by_user_id") @db.Uuid
  requestedAt           DateTime                           @map("requested_at")
  approvedAt            DateTime?                          @map("approved_at")

  @@index([subjectUserAccountId])
  @@index([status])
  @@map("SuperAdminBreakGlassRequest")
  @@schema("platform")
}

// =================================================================================================
// Module `audit` — journal minimal (Phase 0, etape 7/13, ADR-0005 §5). Etendu a l'etape 11/13
// (requetes, retention O-15, console Super Admin) — voir l'ADR pour le perimetre exact.
//
// `platform.AuditEntry`, HORS RLS, `tenant_id` NULLABLE : un evenement MFA en contexte PLATFORM
// (SUPER_ADMIN) n'a structurellement pas de tenant — une politique RLS refuserait purement et
// simplement l'insertion d'une ligne sans `app.tenant_id` positionne (voir ADR-0005 §5 pour le
// raisonnement complet, alternative explicitement ecartee #7). Filtrage tenant PUREMENT
// APPLICATIF pour tout futur consommateur, meme regime que Subscription/Payment/OutboxMessage.
//
// IMMUABILITE : `REVOKE UPDATE, DELETE` sur cette table pour le role applicatif `sih_app` PLUS un
// trigger `BEFORE UPDATE OR DELETE` qui leve — voir la migration correspondante. Le repository
// (`AuditEntryRepository`) n'expose que `append()`/`findById()` : deux defenses independantes,
// jamais une seule.
// =================================================================================================

enum AuditCategory {
  MFA
  /// Ajoutee a l'etape 8/13 (ADR-0006 §8) — evenements de cycle de vie du refresh token
  /// (rotation, reutilisation detectee, revocation). Port dedie (`SessionAuditTrail`), jamais
  /// une extension de l'adaptateur MFA existant (meme raisonnement qu'ADR-0005 §5, alternative 7
  /// explicitement ecartee).
  SESSION
  /// Cinq valeurs ajoutees a l'etape 11/13 (ADR-0009 §2) — la categorie decrit la NATURE du fait
  /// audite, jamais l'identite de qui l'a produit (voir `actorKind`).
  PROVISIONING
  MEMBERSHIP
  SUBSCRIPTION
  BILLING
  AUDIT_ACCESS

  @@schema("platform")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED

  @@schema("platform")
}

/// "Depuis quel contexte" une action a ete accomplie (ADR-0009 §3, B1) — ajoute a l'etape 11/13.
enum ActorKind {
  USER_TENANT
  USER_PLATFORM
  SYSTEM

  @@schema("platform")
}

/// Nature de la cible d'une action auditee (ADR-0009 §3, B1) — ajoute a l'etape 11/13.
enum AuditTargetType {
  USER_ACCOUNT
  MEMBERSHIP
  HEALTH_FACILITY
  SUBSCRIPTION
  PAYMENT
  PLATFORM_INVOICE
  FACILITY_SETTINGS
  AUDIT_TRAIL

  @@schema("platform")
}

/// Miroir exact de `identity/application/ports/AuditTrail.ts::MfaAuditEventType` — voir ce
/// fichier pour la justification de la duplication (un module n'importe jamais le domain/ ni les
/// ports applicatifs d'un autre module).
enum AuditEventType {
  MFA_ENROLLMENT_STARTED
  MFA_ENROLLMENT_CONFIRMED
  MFA_FACTOR_REPLACED
  MFA_CHALLENGE_SUCCEEDED
  MFA_CHALLENGE_FAILED
  MFA_CHALLENGE_BLOCKED
  MFA_BYPASS_ATTEMPTED
  MFA_RECOVERY_CODE_CONSUMED
  MFA_RECOVERY_CODES_EXHAUSTED
  MFA_RECOVERY_CODES_REGENERATED
  MFA_RE_ENROLLMENT_FORCED
  MFA_FACTOR_LOCKED_OUT
  /// Break-glass SUPER_ADMIN (ADR-0005 Amendement 1, O-04 residu 4).
  SUPER_ADMIN_BREAK_GLASS_REQUESTED
  SUPER_ADMIN_BREAK_GLASS_APPROVED
  /// Categorie SESSION (ADR-0006 §8, etape 8/13) — miroir de
  /// `identity/application/ports/SessionAuditTrail.ts::SessionAuditEventType`.
  SESSION_REFRESH_ROTATED
  SESSION_REFRESH_REUSE_DETECTED
  SESSION_REFRESH_REVOKED
  SESSION_ABSOLUTE_CEILING_EXCEEDED
  SESSION_INACTIVITY_TIMEOUT
  /// Etape 11/13 (ADR-0009 §2.1) — fermeture de la lacune "la connexion elle-meme n'est pas auditee".
  SESSION_LOGIN_SUCCEEDED
  SESSION_LOGIN_FAILED
  SESSION_CONTEXT_OPENED
  SESSION_CONTEXT_DENIED
  SESSION_CLOSED
  /// Etape 11/13 (ADR-0009 §2.2) — Saga de provisioning (ADR-0008).
  PROVISIONING_FACILITY_CREATED
  PROVISIONING_CONFIGURATION_SEEDED
  PROVISIONING_COMPLETED
  /// Etape 11/13 (ADR-0009 §2.2) — agregat UserTenantMembership/MembershipRole.
  MEMBERSHIP_GRANTED
  MEMBERSHIP_REVOKED
  MEMBERSHIP_ROLE_ASSIGNED
  MEMBERSHIP_ROLE_UNASSIGNED
  /// Etape 11/13 (ADR-0009 §2.2) — cycle de vie commercial de l'abonnement.
  SUBSCRIPTION_TRIAL_STARTED
  SUBSCRIPTION_PLAN_UPGRADE_REQUESTED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_GRACE_PERIOD_STARTED
  SUBSCRIPTION_DEGRADED_MODE_ENTERED
  SUBSCRIPTION_DEGRADED_MODE_SUSTAINED
  SUBSCRIPTION_REACTIVATED
  /// Etape 11/13 (ADR-0009 §2.2) — Payment (PSP) et PlatformInvoice.
  BILLING_PAYMENT_INITIATED
  BILLING_PAYMENT_CONFIRMED
  BILLING_PLATFORM_INVOICE_ISSUED
  BILLING_PLATFORM_INVOICE_SETTLED
  /// Etape 11/13 (ADR-0009 §7) — consultation du journal lui-meme.
  AUDIT_TRAIL_QUERIED
  AUDIT_TRAIL_QUERY_DENIED

  @@schema("platform")
}

/// Preuve APPEND-ONLY d'une action sensible du SaaS Core (voir domain/AuditEntry.ts). Ecrite DANS
/// LA MEME transaction que l'action auditee (`resolvePrismaClient`, jamais via l'Outbox —
/// ADR-0005 §5, ADR-0009 §4). `reason` : motif en texte libre OBLIGATOIRE pour
/// `MFA_RE_ENROLLMENT_FORCED` et `SUPER_ADMIN_BREAK_GLASS_REQUESTED` en SUCCESS (ADR-0005
/// Amendement 1) — jamais porte par l'evenement Outbox correspondant (minimisation, ADR-0005 §6).
/// DEPUIS ADR-0011 §4.2 (etape 12/13), `reason` porte AUSSI un discriminant MACHINE sur une entree
/// `AUDIT_TRAIL_QUERY_DENIED`/`outcome: DENIED` : `'RATE_LIMIT_EXCEEDED'` (constante nommee,
/// `RecordAuditAccess.ts`) quand le refus est du a la limitation de debit de
/// `GET /api/v1/audit-entries`, `NULL` pour un refus d'AUTORISATION (non-regression exacte) — les
/// deux motifs de refus restent distinguables en base, sans nouvel `AuditEventType` ni migration.
///
/// Etendue ADR-0009 §3/§5 (etape 11/13), MIGRATION STRICTEMENT ADDITIVE (`ADD COLUMN ... DEFAULT`,
/// aucun `UPDATE` sur les lignes existantes) :
///   - `actorKind`/`targetType`/`targetId` : "qui" (depuis quel contexte) / "quoi" (quelle
///     nature de cible). `actorUserId`/`subjectUserId` deviennent NULLABLES, sous contrainte
///     `CHECK` ajoutee en SQL brut (non exprimable en schema Prisma) — voir la migration.
///   - `chainKey` : colonne GENEREE (`GENERATED ALWAYS AS (COALESCE(tenant_id::text, 'PLATFORM'))
///     STORED`) — `@default(dbgenerated(""))` indique a Prisma de ne JAMAIS l'inclure dans un
///     INSERT (la base la calcule seule) ; un `AuditChainKey.derive()` cote domaine calcule
///     EXACTEMENT la meme valeur pour la charge canonique hachee (§5.2).
///   - `chainSequence`/`previousEntryHash`/`entryHash` : position et empreintes de chaine (§5).
///     NULL sur toute ligne ecrite AVANT cette migration (segment "pre-chaine", §5.3, jamais
///     retro-chaine — cela exigerait un `UPDATE`, donc la suspension du trigger append-only).
///     Un trigger `BEFORE INSERT` (voir la migration) refuse toute NOUVELLE ligne dont
///     `entry_hash` est NULL — deuxieme defense independante du contrat applicatif.
model AuditEntry {
  id                String          @id @db.Uuid
  category          AuditCategory
  eventType         AuditEventType  @map("event_type")
  outcome           AuditOutcome
  tenantId          String?         @map("tenant_id") @db.Uuid
  actorKind         ActorKind       @default(USER_TENANT) @map("actor_kind")
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  actorRoleCodes    String[]        @map("actor_role_codes")
  subjectUserId     String?         @map("subject_user_id") @db.Uuid
  targetType        AuditTargetType @default(USER_ACCOUNT) @map("target_type")
  targetId          String?         @map("target_id")
  reason            String?
  sessionId         String?         @map("session_id")
  correlationId     String?         @map("correlation_id")
  occurredAt        DateTime        @map("occurred_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  /// Colonne GENEREE STORED (voir commentaire de tete) — jamais ecrite par Prisma (`dbgenerated`).
  chainKey          String          @default(dbgenerated("COALESCE(tenant_id::text, 'PLATFORM'::text)")) @map("chain_key")
  chainSequence     BigInt?         @map("chain_sequence")
  previousEntryHash String?         @map("previous_entry_hash")
  entryHash         String?         @map("entry_hash")

  @@index([tenantId])
  @@index([subjectUserId])
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([chainKey, chainSequence(sort: Desc)])
  @@map("AuditEntry")
  @@schema("platform")
}

// =================================================================================================
// Module `notifications` — Email + SMS (Phase 0, etape 9/13, O-07, ADR-0007).
//
// `platform.Notification`, HORS RLS : meme regime que `Payment`/`PlatformInvoice` (ADR-0007 §6,
// meme raisonnement que 01-target-architecture.md §3.3) — donnee de niveau plateforme (declenchee
// par des evenements Subscription/plateforme), filtrage tenant PUREMENT APPLICATIF, `tenant_id`
// NULLABLE (une notification de niveau plateforme sans tenant reste possible en principe, meme si
// les deux declencheurs cables a cette etape en portent toujours un).
//
// `@@unique([sourceEventId, channel, recipient])` : cle d'idempotence PERSISTEE, seconde ligne de
// defense derriere `withOutboxIdempotency` (ADR-0007 §6) — jamais un `create()` rattrapant un
// P2002, voir PrismaNotificationRepository.ts (`createMany({ skipDuplicates: true })`).
// `recipient` fait partie de la cle : un meme evenement peut legitimement produire PLUSIEURS
// notifications sur le MEME canal (un ADMIN_ETABLISSEMENT par destinataire resolu, ADR-0007 §4) —
// sans `recipient` dans la cle, seule la PREMIERE notification survivrait silencieusement.
// =================================================================================================

enum NotificationChannel {
  EMAIL
  SMS

  @@schema("platform")
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER

  @@schema("platform")
}

/// Miroir de `domain/value-objects/NotificationTemplateKind.ts` — catalogue FERME (ADR-0007 §1/§7).
enum NotificationTemplateKind {
  SUBSCRIPTION_WELCOME
  SUBSCRIPTION_PLAN_CHANGED
  /// Break-glass SUPER_ADMIN (ADR-0005 Amendement 1, O-04 residu 4).
  SUPER_ADMIN_BREAK_GLASS_REQUESTED
  SUPER_ADMIN_BREAK_GLASS_APPROVED

  @@schema("platform")
}

/// Trace CHAQUE notification (voir domain/Notification.ts, 01-target-architecture.md §6.3/§9.4).
/// `lockedAt`/`lockedBy`/`nextAttemptAt` : meme mecanique de reclamation que `OutboxMessage`
/// (`FOR UPDATE SKIP LOCKED`, ADR-0004), PLUS un backoff explicite (`nextAttemptAt`, ADR-0007 §6)
/// absent d'OutboxMessage. Pas de directive `@updatedAt` (magie Prisma-Client) : `updatedAt` est
/// mis a jour EXPLICITEMENT par chaque mutation SQL (relais/worker), meme discipline que
/// `OutboxMessage` qui ne porte pas non plus de colonne generique equivalente.
model Notification {
  id                String                   @id @db.Uuid
  tenantId          String?                  @map("tenant_id") @db.Uuid
  channel           NotificationChannel
  recipient         String
  templateKind      NotificationTemplateKind @map("template_kind")
  sourceEventId     String                   @map("source_event_id") @db.Uuid
  status            NotificationStatus       @default(PENDING)
  attempts          Int                      @default(0)
  lastError         String?                  @map("last_error")
  providerMessageId String?                  @map("provider_message_id")
  lockedAt          DateTime?                @map("locked_at")
  lockedBy          String?                  @map("locked_by")
  nextAttemptAt     DateTime?                @map("next_attempt_at")
  createdAt         DateTime                 @map("created_at")
  updatedAt         DateTime                 @map("updated_at")
  sentAt            DateTime?                @map("sent_at")

  @@unique([sourceEventId, channel, recipient])
  @@index([tenantId])
  @@index([status, lockedAt])
  @@map("Notification")
  @@schema("platform")
}

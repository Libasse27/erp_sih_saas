// Schema Prisma — Module Identity + RBAC + UserTenantMembership (Phase 0, etape 2/13).
//
// Deux schemas PostgreSQL, conformement a ADR-0001 / 01-target-architecture.md §3.3 :
//   - "platform" : donnees de niveau plateforme, hors RLS tenant (UserAccount, Permission).
//   - "public"   : donnees tenant-scoped, RLS FORCE (UserTenantMembership, MembershipRole,
//                  HealthFacility), et le catalogue de roles (Role — voir commentaire sur ce
//                  modele : les lignes SYSTEM sont globales, les lignes TENANT sont
//                  RLS-isolees, une seule table porte les deux via `tenant_id NULL` pour les
//                  roles systeme).
//
// Les politiques RLS elles-memes (ALTER TABLE ... FORCE ROW LEVEL SECURITY, CREATE POLICY) ne
// sont pas exprimables en langage de schema Prisma : elles sont ajoutees a la main dans la
// migration SQL generee (prisma/migrations/<ts>_identity_rbac_init/migration.sql), avec un
// commentaire explicite les reperant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "public"]
}

enum PlatformRole {
  SUPER_ADMIN
  NONE

  @@schema("platform")
}

enum RoleScope {
  SYSTEM
  TENANT

  @@schema("public")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED

  @@schema("public")
}

/// Identite globale d'une personne (voir domain/UserAccount.ts). Aucun tenant_id : c'est ce
/// qui permet de retrouver un compte par email au login, avant qu'un contexte tenant existe.
model UserAccount {
  id           String       @id @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  platformRole PlatformRole @map("platform_role")
  createdAt    DateTime     @map("created_at")

  @@map("UserAccount")
  @@schema("platform")
}

/// Catalogue de permissions — niveau plateforme, source de verite unique (01-target-architecture.md §7.2).
model Permission {
  code        String   @id
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@schema("platform")
}

/// Role systeme (scope SYSTEM, tenant_id NULL, catalogue global immuable des 18 roles) OU role
/// personnalise d'etablissement (scope TENANT, tenant_id obligatoire). Une seule table pour les
/// deux : la politique RLS `tenant_isolation` couvre les lignes TENANT, une politique
/// additionnelle `system_role_catalog_read` (voir migration) autorise la lecture des lignes
/// SYSTEM (tenant_id NULL) quel que soit le contexte de session.
model Role {
  id              String    @id @db.Uuid
  code            String
  name            String
  scope           RoleScope
  tenantId        String?   @map("tenant_id") @db.Uuid
  permissionCodes String[]  @map("permission_codes")
  createdAt       DateTime  @default(now()) @map("created_at")

  membershipRoles MembershipRole[]

  // Unicite des roles TENANT par (tenant_id, code) ; l'unicite globale des codes SYSTEM
  // (tenant_id NULL) est imposee par un index partiel ajoute a la main en migration, car
  // Postgres ne traite pas NULL comme une valeur egale a elle-meme dans une contrainte UNIQUE
  // standard.
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("Role")
  @@schema("public")
}

/// Appartenance d'un UserAccount a UN etablissement (voir domain/UserTenantMembership.ts).
/// Table tenant-scoped, RLS FORCE.
model UserTenantMembership {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  status    MembershipStatus
  joinedAt  DateTime         @map("joined_at")
  leftAt    DateTime?        @map("left_at")
  createdAt DateTime         @map("created_at")
  createdBy String           @map("created_by") @db.Uuid

  roles MembershipRole[]

  // Pas de contrainte UNIQUE(user_id, tenant_id) globale : un membership REVOKED n'empeche pas
  // un octroi ulterieur (nouvelle ligne). L'unicite porte uniquement sur les memberships ACTIFS
  // — imposee par un index unique partiel ajoute a la main en migration (defense en profondeur
  // en plus du controle applicatif de GrantMembershipHandler).
  @@index([tenantId, status])
  @@index([userId, tenantId])
  @@map("UserTenantMembership")
  @@schema("public")
}

/// Table de jonction membership <-> role (un membership peut porter plusieurs roles
/// simultanes — decision non negociable de cette etape). `tenant_id` est denormalise depuis le
/// membership pour que la politique RLS s'applique directement sur cette table sans jointure.
model MembershipRole {
  id           String   @id @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assignedAt   DateTime @map("assigned_at")

  membership UserTenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([tenantId])
  @@map("MembershipRole")
  @@schema("public")
}

enum FacilityStatus {
  ACTIVE
  SUSPENDED

  @@schema("public")
}

// =================================================================================================
// Module Subscription (Phase 0, etape 4/13) — Plan / PlanPrice / Subscription / SubscriptionPlanChange.
//
// Toutes ces tables vivent dans le schema "platform", EXPLICITEMENT SANS RLS (ADR-0001 §3.3 :
// "Les donnees de niveau plateforme vivent dans un schema platform distinct, hors RLS tenant" —
// abonnements et forfaits sont cites nommement dans cette decision). Ne JAMAIS ajouter de
// politique RLS ni de FORCE ROW LEVEL SECURITY sur ces tables : ce serait contraire a la
// conception actee, et romprait la coherence documentee ici. `Subscription` et
// `SubscriptionPlanChange` portent tout de meme `tenant_id` (colonne simple, sans politique) : ce
// n'est PAS un oubli d'y ajouter du RLS, c'est un choix — le filtrage tenant sur ces deux tables
// est PUREMENT APPLICATIF (voir PrismaSubscriptionRepository.ts / PrismaPlanChangeRepository.ts,
// qui filtrent explicitement par tenant_id sur CHAQUE methode ; couvert par
// test/subscription/integration/subscriptionRepositoryTenantIsolation.test.ts, qui joue le meme
// role que rls.test.ts pour les tables du schema public).
//
// `Plan` et `PlanPrice` n'ont, eux, aucune notion de tenant : catalogue global visible de tous.
//
// Aucune contrainte FOREIGN KEY declaree via `@relation` Prisma sur les colonnes planId /
// planPriceId / fromPlanId / toPlanId / fromPlanPriceId / toPlanPriceId : choix deliberement
// minimal pour eviter la prolifération de relations nommees (plusieurs FK vers le meme modele
// sur SubscriptionPlanChange). L'integrite referentielle est appliquee a la main en migration
// SQL (ALTER TABLE ... ADD CONSTRAINT ... FOREIGN KEY), meme pattern que les ajouts manuels deja
// presents dans ce schema (politiques RLS, index partiels) — voir le commentaire en tete de la
// migration correspondante.
// =================================================================================================

enum PlanCode {
  STANDARD
  PROFESSIONNEL
  COMPLET

  @@schema("platform")
}

enum BillingPeriod {
  MENSUEL
  ANNUEL

  @@schema("platform")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE

  @@schema("platform")
}

/// Une seule valeur en V1 : le downgrade reste differe a la fin de periode et n'est pas
/// implemente par cette etape (O-02.6) — voir domain/value-objects/PlanChangeType.ts.
enum SubscriptionPlanChangeType {
  UPGRADE

  @@schema("platform")
}

/// Catalogue global de forfaits (voir domain/Plan.ts). Aucun tenant_id : visible de tous.
model Plan {
  id        String   @id @db.Uuid
  code      PlanCode @unique
  name      String
  maxUsers  Int      @map("max_users")
  maxBeds   Int      @map("max_beds")
  createdAt DateTime @map("created_at")

  @@map("Plan")
  @@schema("platform")
}

/// Tarif historise d'un Plan, DISTINCT du Plan lui-meme (voir domain/PlanPrice.ts). Append-only :
/// aucune ligne existante n'est jamais mise a jour, un nouveau tarif = une nouvelle ligne.
model PlanPrice {
  id            String        @id @db.Uuid
  planId        String        @map("plan_id") @db.Uuid
  amount        Int
  period        BillingPeriod
  effectiveFrom DateTime      @map("effective_from")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([planId, period, effectiveFrom])
  @@map("PlanPrice")
  @@schema("platform")
}

/// Agregat racine liant un tenant a un forfait via le PlanPrice reellement applique (voir
/// domain/Subscription.ts). `tenant_id` colonne simple, SANS RLS (voir commentaire de tete de
/// section) — filtrage explicite obligatoire dans chaque methode du repository.
/// `@@unique([tenantId])` impose l'invariant "un Tenant a exactement un Subscription" au niveau
/// base, en plus de la verification applicative.
model Subscription {
  id                 String             @id @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  currentPlanPriceId String             @map("current_plan_price_id") @db.Uuid
  period             BillingPeriod
  status             SubscriptionStatus
  trialEndsAt        DateTime?          @map("trial_ends_at")
  periodStartsAt     DateTime           @map("period_starts_at")
  periodEndsAt       DateTime           @map("period_ends_at")
  createdAt          DateTime           @map("created_at")

  @@unique([tenantId])
  @@map("Subscription")
  @@schema("platform")
}

/// Historique APPEND-ONLY des changements de forfait (voir domain/PlanChange.ts). `tenant_id`
/// colonne simple, SANS RLS, meme regime que Subscription ci-dessus.
model SubscriptionPlanChange {
  id              String                     @id @db.Uuid
  subscriptionId  String                     @map("subscription_id") @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  changeType      SubscriptionPlanChangeType @map("change_type")
  fromPlanId      String                     @map("from_plan_id") @db.Uuid
  fromPlanPriceId String                     @map("from_plan_price_id") @db.Uuid
  toPlanId        String                     @map("to_plan_id") @db.Uuid
  toPlanPriceId   String                     @map("to_plan_price_id") @db.Uuid
  proratedAmount  Int                        @map("prorated_amount")
  occurredAt      DateTime                   @map("occurred_at")

  @@index([subscriptionId])
  @@index([tenantId])
  @@map("SubscriptionPlanChange")
  @@schema("platform")
}

/// Agregat racine du tenant (voir domain/HealthFacility.ts, 01-target-architecture.md §6.4).
/// Module Tenant (Phase 0, etape 3/13) — perimetre volontairement minimal : isolation RLS,
/// pas le modele metier complet de l'etablissement (FacilityType, Service, Building, Room, Bed
/// restent hors perimetre).
///
/// `tenant_id` DUPLIQUE INTENTIONNELLEMENT `id` — ce n'est pas une redondance accidentelle.
/// Cette table EST le tenant lui-meme (contrairement a toutes les autres tables tenant-scoped
/// de ce schema, ou `tenant_id` reference un tenant distinct de la ligne). Le garde-fou
/// generique de non-fuite RLS impose par ADR-0001 (section "Consequences") enumere TOUTES les
/// tables du schema "public" et echoue si l'une d'elles n'a pas `tenant_id NOT NULL` **et** une
/// politique RLS active, SANS exception pour l'agregat racine — voir
/// test/tenant/integration/rlsGuard.test.ts. Omettre `tenant_id` sur cette table pour la seule
/// raison qu'elle "est" le tenant serait exactement le genre d'exception ad hoc que ce
/// garde-fou generique est cense rendre impossible d'oublier.
model HealthFacility {
  id        String         @id @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  name      String
  status    FacilityStatus
  createdAt DateTime       @map("created_at")

  @@map("HealthFacility")
  @@schema("public")
}

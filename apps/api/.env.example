NODE_ENV=development
PORT=3000

# Connexion RUNTIME de l'application : role Postgres applicatif, non-superuser, non-BYPASSRLS
# (sih_app, cree par la migration 20260823173817_identity_rbac_app_role). Ne jamais utiliser le
# role de bootstrap "sih" (superuser du cluster) a l'execution : un superuser Postgres ignore
# systematiquement le Row-Level Security, y compris FORCE ROW LEVEL SECURITY (ADR-0001 couche 4
# serait alors totalement inoperante).
DATABASE_URL="postgresql://sih_app:sih_app_dev_only@localhost:5432/sih_dev?schema=public"

REDIS_URL="redis://localhost:6379"

# Pour EXECUTER des migrations Prisma (DDL), utiliser ponctuellement le role superuser :
#   DATABASE_URL="postgresql://sih:sih_dev_only@localhost:5432/sih_dev?schema=public" npx prisma migrate deploy

# Secret HMAC du prestataire de paiement SaaS SANDBOX (O-25.3/O-25.5). Aucun prestataire reel
# n'est encore retenu (residu O-25) — ce secret ne sert qu'a l'adaptateur sandbox
# (SandboxPaymentProviderAdapter). Ne JAMAIS reutiliser cette valeur en production.
PAYMENT_PROVIDER_WEBHOOK_SECRET="change_me_dev_only_at_least_32_chars"
